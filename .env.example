# PostgreSQL connection (Neon recommended for Vercel)
# Get from: https://neon.tech  → New project → Connection string
DATABASE_URL="postgresql://user:password@host/uaeconomy?sslmode=require"

# NextAuth.js session encryption — required, the app will not start without it
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Protects the /api/cron/tick endpoint from unauthorized calls
# Generate: openssl rand -hex 32
CRON_SECRET="replace-with-random-secret"

# Game tick interval for the local `npm run engine:tick` runner (ms).
# Vercel production uses an external cron service instead (see vercel.json).
TICK_INTERVAL_MS=3600000

# Node environment
NODE_ENV="development"

# Error monitoring (Sentry) — optional. Leave empty to disable; the app
# works fine without it. Get DSN from sentry.io → Project Settings → Client Keys.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed in CI/Vercel to upload source maps for readable stack traces.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Rate-limiting store (Upstash Redis, REST API) — optional. Without these,
# rate-limiting falls back to a weaker in-memory check (per warm instance).
# Get from: https://upstash.com → Redis database → REST API section
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
