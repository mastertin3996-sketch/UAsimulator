# PostgreSQL connection (Neon recommended for Vercel)
# Get from: https://neon.tech  → New project → Connection string
DATABASE_URL="postgresql://user:password@host/uaeconomy?sslmode=require"

# NextAuth.js session encryption — required, the app will not start without it
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Protects the /api/cron/tick endpoint from unauthorized calls
# Generate: openssl rand -hex 32
CRON_SECRET="replace-with-random-secret"

# Game tick interval for the local `npm run engine:tick` runner (ms).
# Vercel production uses an external cron service instead (see vercel.json).
TICK_INTERVAL_MS=3600000

# Node environment
NODE_ENV="development"
